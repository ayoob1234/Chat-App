<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your Chat </title>
</head>
<body>
    <p>Edit Your Chat : <b><%= chat._id %></b> </p>
    <p>This chat was sent by from : <b> <%= chat.from %> </b>to  <b><%= chat.to %></b> </p>
    <form method="post" action="/chats/<%= chat._id %>?_method=PUT">

      <textarea name="msg" rows="10" cols="30"> <%= chat.msg %></textarea> <br><br>
        <button>Edit</button>
    </form>

</body>
</html>